@page "/chat"
@rendermode InteractiveServer
@inject IRagService RagService
@inject ISearchService SearchService
@inject ILogger<Chat> Logger

<PageTitle>Minutes Studio — Chat</PageTitle>

<div class="studio">
    <header class="studio-header chat-header">
        <div>
            <h1>Chat with the Documents</h1>
            <p class="subtitle">
                Ask anything about the indexed meeting minutes. Pin the conversation to a single meeting
                for pointed questions, or leave it on All meetings to search across everything.
            </p>
        </div>
        @if (_messages.Count > 0)
        {
            <button class="btn-secondary" @onclick="ClearChat" disabled="@_busy">Clear chat</button>
        }
    </header>

    @if (_documents is { Count: > 0 })
    {
        <section class="doc-picker">
            <span class="picker-label">Chatting with</span>
            <div class="pill-row">
                <button type="button" class="pill @(_selectedSource is null ? "selected" : "")"
                        @onclick="() => SelectSource(null)" disabled="@_busy">
                    All meetings
                </button>
                @foreach (var doc in _documents)
                {
                    <button type="button" class="pill @(_selectedSource == doc.SourceFile ? "selected" : "")"
                            @onclick="() => SelectSource(doc.SourceFile)" disabled="@_busy">
                        @doc.Title
                    </button>
                }
            </div>
        </section>
    }

    <section class="chat-thread">
        @if (_messages.Count == 0)
        {
            <div class="chat-empty">
                <p class="chat-empty-title">Ask about the meeting minutes — try one of these:</p>
                <div class="sample-queries">
                    @foreach (var q in SampleQueries)
                    {
                        <button type="button" class="sample-query" @onclick="() => SendQuery(q)" disabled="@_busy">
                            @q
                        </button>
                    }
                </div>
            </div>
        }

        @foreach (var m in _messages)
        {
            <div class="chat-msg @(m.IsUser ? "user" : "assistant")">
                <div class="chat-bubble">
                    @if (m.IsUser)
                    {
                        @m.Text
                    }
                    else
                    {
                        @MarkdownHelper.ToHtml(m.Text)
                        @if (m.Sources is { Count: > 0 })
                        {
                            <div class="chat-sources">
                                @foreach (var s in m.Sources)
                                {
                                    <span class="chip">@s.Title</span>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }

        @if (_busy)
        {
            <div class="chat-msg assistant">
                <div class="chat-bubble"><span class="spinner spinner-dark"></span> Thinking…</div>
            </div>
        }
    </section>

    @if (_error is not null)
    {
        <div class="alert alert-error">@_error</div>
    }

    <section class="chat-input">
        <textarea rows="2" @bind="_input" @bind:event="oninput" disabled="@_busy"
                  placeholder="Ask a question about the minutes…"
                  @onkeydown="OnKeyDown"></textarea>
        <button class="btn-primary" @onclick="Send" disabled="@_busy">Send</button>
    </section>
</div>

<ReferencePanel />

@code {
    private sealed class Message
    {
        public bool IsUser { get; init; }
        public string Text { get; set; } = string.Empty;
        public IReadOnlyList<RetrievedChunk>? Sources { get; set; }
    }

    private static readonly string[] SampleQueries =
    {
        "Which nominations were approved, and what were the vote counts?",
        "Which nominees faced opposition, and who objected and why?",
        "What amendments were debated, and did they pass or fail?",
        "What resolutions were discussed?",
        "What bills or resolutions were advanced to the floor?",
        "What concerns did senators raise about ambassador vacancies or delays?",
        "List every roll-call vote and its outcome."
    };

    private readonly List<Message> _messages = new();
    private IReadOnlyList<DocumentInfo>? _documents;
    private string? _selectedSource;
    private string _input = string.Empty;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _documents = await SearchService.ListDocumentsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load documents for chat scope.");
            _documents = Array.Empty<DocumentInfo>();
        }
    }

    private void SelectSource(string? sourceFile) => _selectedSource = sourceFile;

    private void ClearChat()
    {
        _messages.Clear();
        _error = null;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendQuery(_input);
    }

    private Task Send() => SendQuery(_input);

    private async Task SendQuery(string rawQuestion)
    {
        var question = rawQuestion.Trim();
        if (question.Length == 0 || _busy) return;

        _error = null;
        _messages.Add(new Message { IsUser = true, Text = question });
        _input = string.Empty;
        _busy = true;

        try
        {
            var answer = await RagService.AskAsync(question, _selectedSource);
            _messages.Add(new Message
            {
                IsUser = false,
                Text = string.IsNullOrWhiteSpace(answer.Content)
                    ? (answer.Warning ?? "No answer.")
                    : answer.Content,
                Sources = answer.Sources
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Chat failed.");
            _error = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
