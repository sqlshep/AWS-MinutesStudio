{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Bedrock": {
    "Region": "us-east-1",
    "ChatModelId": "us.amazon.nova-2-lite-v1:0",
    "EmbeddingModelId": "amazon.titan-embed-text-v2:0",
    "EmbeddingDimensions": 1024,
    "MaxOutputTokens": 4096
  },
  "OpenSearch": {
    "Endpoint": "https://<your-opensearch-domain>.<region>.es.amazonaws.com",
    "Region": "us-east-1",
    "IndexName": "minutesstudio-minutes"
  },
  "S3": {
    "BucketName": "aws-minutes",
    "Region": "us-east-1",
    "Prefix": ""
  },
  "Rag": {
    "ChunkSizeChars": 3500,
    "ChunkOverlapChars": 400,
    "TopK": 6,
    "SamplesPath": "../../samples"
  }
}
